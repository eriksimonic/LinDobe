+    status = m_vkd->vkCreateSwapchainKHR(m_vkd->device(), &swapInfo, nullptr, &m_swapchain);
+
+    if (status == VK_ERROR_INITIALIZATION_FAILED && evictIdleSwapchains(this, 16u)) {
+      m_swapchain = VK_NULL_HANDLE;
+      status = m_vkd->vkCreateSwapchainKHR(m_vkd->device(), &swapInfo, nullptr, &m_swapchain);
+    }
+
+    if (status) {
+      m_swapchain = VK_NULL_HANDLE;
       Logger::err(str::format("Presenter: Failed to create Vulkan swapchain: ", status));
       return status;
     }
+
+    s_liveSwapchains += 1u;
     
     // Import actual swap chain images
     std::vector<VkImage> images;
@@ -1244,8 +1370,10 @@ namespace dxvk {
     }
 
     // The conditional is here because some third party layers don't properly handle null swapchains
-    if (m_swapchain)
+    if (m_swapchain) {
       m_vkd->vkDestroySwapchainKHR(m_vkd->device(), m_swapchain, nullptr);
+      s_liveSwapchains -= 1u;
+    }
 
     m_images.clear();
