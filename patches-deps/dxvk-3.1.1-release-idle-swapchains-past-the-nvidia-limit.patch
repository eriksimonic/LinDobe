index f93ae8d..d6a130e 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -7,6 +7,111 @@
 
 namespace dxvk {
 
+  // AdobeWine: the NVIDIA Linux driver refuses a process's 253rd live VkSwapchainKHR with
+  // VK_ERROR_INITIALIZATION_FAILED (wine/tests/misc/vkswapcap.c, no Wine involved; surfaces alone are not
+  // limited, Intel takes 300+). Windows has no such limit, and Adobe Audition keeps ~250 DXGI swapchains alive in a
+  // long session (one per dvaui panel it ever showed); the failed creation then ended in a device loss and a hang.
+  // So all presenters are listed, live swapchains are counted, and above the limit (DXVK_SWAPCHAIN_LIMIT, default
+  // 192) or after a refusal the least recently used idle presenters destroy their swapchain; they recreate it on
+  // their next acquire, the same path a minimised window takes.
+  static dxvk::mutex             s_presenterMutex;
+  static std::vector<Presenter*> s_presenters;
+  static std::atomic<uint32_t>   s_liveSwapchains = { 0u };
+
+  static uint32_t swapchainLimit() {
+    static const uint32_t limit = [] {
+      std::string v = env::getEnvVar("DXVK_SWAPCHAIN_LIMIT");
+      return v.empty() ? 192u : uint32_t(std::max(8, std::atoi(v.c_str())));
+    } ();
+    return limit;
+  }
+
+
+  void Presenter::registerPresenter(Presenter* presenter, bool add) {
+    std::lock_guard lock(s_presenterMutex);
+
+    if (add)
+      s_presenters.push_back(presenter);
+    else
+      s_presenters.erase(std::remove(s_presenters.begin(), s_presenters.end(), presenter), s_presenters.end());
+  }
+
+
+  uint32_t Presenter::evictIdleSwapchains(Presenter* self, uint32_t count) {
+    std::lock_guard lock(s_presenterMutex);
+
+    std::vector<Presenter*> idle;
+
+    for (auto p : s_presenters) {
+      if (p != self && p->m_device == self->m_device)
+        idle.push_back(p);
+    }
+
+    std::sort(idle.begin(), idle.end(), [] (const Presenter* a, const Presenter* b) {
+      return a->m_lastUsed < b->m_lastUsed;
+    });
+
+    auto now = high_resolution_clock::now();
+    uint32_t evicted = 0u;
+
+    for (auto p : idle) {
+      if (evicted >= count)
+        break;
+
+      // Never wait for another presenter: one that is busy is not idle
+      std::unique_lock other(p->m_surfaceMutex, std::try_to_lock);
+
+      if (!other.owns_lock() || !p->m_swapchain || p->m_presentPending
+       || now - p->m_lastUsed < std::chrono::milliseconds(500))
+        continue;
+
+      p->destroySwapchain();
+      evicted += 1u;
+    }
+
+    if (evicted)
+      Logger::info(str::format("Presenter: released ", evicted, " idle swapchains, ", s_liveSwapchains.load(), " live"));
+
+    return evicted;
+  }
+
+  // AdobeWine: a live VkSwapchainKHR whose window was destroyed (the app keeps the DXGI swapchain, as Audition
+  // does) can make the NVIDIA driver lose the device on a later submit, idle or not (wine/tests/misc/swapchurn.c
+  // KEEP=1). Wine reports such a surface as lost, so before each new swapchain the idle presenters whose window is
+  // gone give theirs up; a later acquire recreates it if the window comes back.
+  uint32_t Presenter::releaseOrphanedSwapchains(Presenter* self) {
+    std::lock_guard lock(s_presenterMutex);
+
+    auto now = high_resolution_clock::now();
+    uint32_t released = 0u;
+
+    for (auto p : s_presenters) {
+      if (p == self || p->m_device != self->m_device)
+        continue;
+
+      // Only presenters idle for a while: the query must not overlap their own presents
+      std::unique_lock other(p->m_surfaceMutex, std::try_to_lock);
+
+      if (!other.owns_lock() || !p->m_swapchain || !p->m_surface || p->m_presentPending
+       || now - p->m_lastUsed < std::chrono::milliseconds(500))
+        continue;
+
+      VkSurfaceCapabilitiesKHR caps = { };
+
+      if (p->m_vki->vkGetPhysicalDeviceSurfaceCapabilitiesKHR(p->m_device->adapter()->handle(),
+          p->m_surface, &caps) != VK_ERROR_SURFACE_LOST_KHR)
+        continue;
+
+      p->destroySwapchain();
+      released += 1u;
+    }
+
+    if (released)
+      Logger::info(str::format("Presenter: released ", released, " swapchains of destroyed windows, ", s_liveSwapchains.load(), " live"));
+
+    return released;
+  }
+
