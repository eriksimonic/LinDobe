-    pCounterInfo->NumSimultaneousCounters     = 0;
+    // We basically don't support counters, except Intel's device information counter
+    pCounterInfo->LastDeviceDependentCounter  = GetIntelGpuArchitecture() ? D3D11_COUNTER_DEVICE_DEPENDENT_0 : D3D11_COUNTER(0);
+    pCounterInfo->NumSimultaneousCounters     = GetIntelGpuArchitecture() ? 1 : 0;
     pCounterInfo->NumDetectableParallelUnits  = 0;
   }
   
@@ -1753,6 +1797,24 @@ namespace dxvk {
           UINT*               pUnitsLength,
           LPSTR               szDescription,
           UINT*               pDescriptionLength) {
+    if (pDesc && pDesc->Counter == D3D11_COUNTER_DEVICE_DEPENDENT_0 && GetIntelGpuArchitecture()) {
+      // the D3D11 rule: a null string returns its length (with the terminator); a short buffer is an error
+      auto put = [] (LPSTR dst, UINT* len, const char* src) {
+        UINT need = UINT(std::strlen(src) + 1);
+        if (!len) return true;
+        if (dst) { if (*len < need) return false; std::memcpy(dst, src, need); }
+        *len = need;
+        return true;
+      };
+      if (pType) *pType = D3D11_COUNTER_TYPE_UINT32;
+      if (pActiveCounters) *pActiveCounters = 1;
+      if (!put(szName, pNameLength, "Intel Device Information")
+       || !put(szUnits, pUnitsLength, "Size 24")
+       || !put(szDescription, pDescriptionLength, "Version 2"))
+        return E_INVALIDARG;
+      return S_OK;
+    }
+
     Logger::err("D3D11: Counters not supported");
     return E_INVALIDARG;
   }
