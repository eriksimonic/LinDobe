+
+  uint32_t D3D11Device::GetIntelGpuArchitecture() {
+    // Intel's PRODUCT_FAMILY numbers (the GPUArchitecture field of the "Intel Device Information" counter, see
+    // Intel GPUDetect's INTEL_GPU_ARCHITECTURE), from the PCI device id. 0: not an Intel GPU we know.
+    const auto& props = m_dxvkDevice->properties().core.properties;
+    if (props.vendorID != 0x8086)
+      return 0;
+
+    uint32_t id = props.deviceID, hi = id & 0xff00;
+    if (hi == 0x9a00) return 0x21;                       // Tiger Lake LP (Iris Xe)
+    if (hi == 0x4c00) return 0x23;                       // Rocket Lake
+    if (id >= 0x46d0 && id <= 0x46df) return 0x26;       // Alder Lake N
+    if ((id >= 0x4680 && id <= 0x469f) || (id >= 0xa780 && id <= 0xa79f)) return 0x24;   // Alder/Raptor Lake S
+    if (hi == 0x4600 || hi == 0xa700) return 0x25;       // Alder/Raptor Lake P (Iris Xe)
+    if (hi == 0x4900) return 0x4ba;                      // DG1
+    if (hi == 0x5600) return 1270;                       // Arc Alchemist (DG2)
+    if (hi == 0x7d00) return (id == 0x7d67 || id == 0x7d51 || id == 0x7dd1 || id == 0x7d41) ? 1273 : 1272;   // Arrow / Meteor Lake
+    if (hi == 0xe200) return 1274;                       // Arc Battlemage
+    if (hi == 0x6400) return 1275;                       // Lunar Lake
+    if (hi == 0xb000) return 1300;                       // Panther Lake
+    if (hi == 0x8a00) return 0x1d;                       // Ice Lake LP
+    if (hi == 0x9b00 || hi == 0x3e00) return 0x14;       // Comet / Coffee Lake
+    return 0;
+  }
   
   
