+/* The GPUs as win32u registers them (the display class devices: PCI ids, LUID, DriverDesc, DriverVersion, memory),
+ * the data WMI and SetupAPI report. wined3d's identifier is only a fallback: its card tables stop at old GPUs and,
+ * without a GL context (Mesa's EGL on another vendor's X server), it reports a default "Intel(R) HD Graphics 4000"
+ * with a 2013 driver, which Premiere Pro rejects as "Hardware out of date". */
+static void parse_pci_ids(const WCHAR *id, struct wined3d_adapter_identifier *ident)
+{
+    const WCHAR *p;
+    if ((p = wcsstr(id, L"VEN_"))) ident->vendor_id = wcstoul(p + 4, NULL, 16);
+    if ((p = wcsstr(id, L"DEV_"))) ident->device_id = wcstoul(p + 4, NULL, 16);
+    if ((p = wcsstr(id, L"SUBSYS_"))) ident->subsystem_id = wcstoul(p + 7, NULL, 16);
+    if ((p = wcsstr(id, L"REV_"))) ident->revision = wcstoul(p + 4, NULL, 16);
+}
+
+static BOOL registry_adapter(HDEVINFO set, SP_DEVINFO_DATA *dev, struct dxcore_adapter *adapter)
+{
+    struct wined3d_adapter_identifier *ident = &adapter->identifier;
+    WCHAR id[256], driver[128], desc[128], version[64], path[256];
+    unsigned int a = 0, b = 0, c = 0, d = 0;
+    MEMORYSTATUSEX mem = {.dwLength = sizeof(mem)};
+    DEVPROPTYPE type;
+    UINT64 luid, size;
+    DWORD len;
+    HKEY key;
+
+    if (!SetupDiGetDevicePropertyW(set, dev, &DEVPROPKEY_GPU_LUID, &type, (BYTE *)&luid, sizeof(luid), NULL, 0))
+        return FALSE;
+    if (!SetupDiGetDeviceInstanceIdW(set, dev, id, ARRAY_SIZE(id), NULL)) return FALSE;
+    if (!SetupDiGetDevicePropertyW(set, dev, &DEVPKEY_Device_Driver, &type, (BYTE *)driver, sizeof(driver), NULL, 0))
+        return FALSE;
+
+    memset(ident, 0, sizeof(*ident));
+    ident->description = adapter->driver_description;
+    ident->description_size = sizeof(adapter->driver_description);
+    memcpy(&ident->adapter_luid, &luid, sizeof(luid));
+    parse_pci_ids(id, ident);
+
+    swprintf(path, ARRAY_SIZE(path), L"System\\CurrentControlSet\\Control\\Class\\%s", driver);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, KEY_QUERY_VALUE, &key)) return FALSE;
+    len = sizeof(desc);
+    if (RegQueryValueExW(key, L"DriverDesc", NULL, NULL, (BYTE *)desc, &len)) desc[0] = 0;
+    len = sizeof(version);
+    if (!RegQueryValueExW(key, L"DriverVersion", NULL, NULL, (BYTE *)version, &len)
+            && swscanf(version, L"%u.%u.%u.%u", &a, &b, &c, &d) == 4)
+        ident->driver_version.QuadPart = (UINT64)a << 48 | (UINT64)b << 32 | (UINT64)c << 16 | d;
+    len = sizeof(size);
+    if (!RegQueryValueExW(key, L"HardwareInformation.qwMemorySize", NULL, NULL, (BYTE *)&size, &len))
+        ident->video_memory = size;
+    RegCloseKey(key);
+
+    WideCharToMultiByte(CP_ACP, 0, desc, -1, adapter->driver_description, sizeof(adapter->driver_description), NULL, NULL);
+    GlobalMemoryStatusEx(&mem);
+    ident->shared_system_memory = mem.ullTotalPhys / 2;
+    TRACE("%s: %04lx:%04lx %s, driver %s, luid %#I64x, memory %I64u MB.\n", debugstr_w(id), ident->vendor_id,
+            ident->device_id, debugstr_a(adapter->driver_description), debugstr_w(version), luid, ident->video_memory >> 20);
+    return TRUE;
+}
+
+static HRESULT get_registry_adapters(struct dxcore_adapter_list *list)
+{
+    SP_DEVINFO_DATA dev = {.cbSize = sizeof(dev)};
+    struct dxcore_adapter *adapter;
+    HDEVINFO set;
+    DWORD i;
+
+    set = SetupDiGetClassDevsW(&GUID_DEVCLASS_DISPLAY, NULL, NULL, DIGCF_PRESENT);
+    if (set == INVALID_HANDLE_VALUE) return E_FAIL;
+    for (i = 0; SetupDiEnumDeviceInfo(set, i, &dev); i++)
+    {
+        if (!(adapter = calloc(1, sizeof(*adapter)))) break;
+        adapter->IDXCoreAdapter_iface.lpVtbl = &dxcore_adapter_vtbl;
+        adapter->refcount = 1;
+        if (!registry_adapter(set, &dev, adapter) || !adapter->identifier.vendor_id)
+        {
+            free(adapter);
+            continue;
+        }
+        if (!(list->adapters = realloc(list->adapters, (list->adapter_count + 1) * sizeof(*list->adapters))))
+        {
+            free(adapter);
+            list->adapter_count = 0;
+            break;
+        }
+        list->adapters[list->adapter_count++] = adapter;
+    }
+    SetupDiDestroyDeviceInfoList(set);
+    return list->adapter_count ? S_OK : E_FAIL;
+}
