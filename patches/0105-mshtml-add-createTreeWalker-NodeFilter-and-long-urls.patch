--- a/dlls/mshtml/htmlnode.c
+++ b/dlls/mshtml/htmlnode.c
@@ -1698,3 +1698,621 @@
     IHTMLDOMNode_Release(&document->node.IHTMLDOMNode_iface);
     return hres;
 }
+
+#define SHOW_EVERYTHING 0xffffffff
+#define FILTER_ACCEPT 1
+#define FILTER_REJECT 2
+#define FILTER_SKIP   3
+
+struct tree_walker {
+    DispatchEx dispex;
+    IWineDOMTreeWalker IWineDOMTreeWalker_iface;
+
+    HTMLDocumentNode *doc;
+    nsIDOMNode *root;
+    nsIDOMNode *current;
+    ULONG what_to_show;
+    IDispatch *filter;
+    VARIANT_BOOL expand;
+};
+
+static inline struct tree_walker *impl_from_IWineDOMTreeWalker(IWineDOMTreeWalker *iface)
+{
+    return CONTAINING_RECORD(iface, struct tree_walker, IWineDOMTreeWalker_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(tree_walker, IWineDOMTreeWalker, impl_from_IWineDOMTreeWalker(iface)->dispex)
+
+static nsIDOMNode *node_parent(nsIDOMNode *node)
+{
+    nsIDOMNode *ret = NULL;
+    nsIDOMNode_GetParentNode(node, &ret);
+    return ret;
+}
+
+static nsIDOMNode *node_child(nsIDOMNode *node, BOOL last)
+{
+    nsIDOMNode *ret = NULL;
+    if(last)
+        nsIDOMNode_GetLastChild(node, &ret);
+    else
+        nsIDOMNode_GetFirstChild(node, &ret);
+    return ret;
+}
+
+static nsIDOMNode *node_sibling(nsIDOMNode *node, BOOL prev)
+{
+    nsIDOMNode *ret = NULL;
+    if(prev)
+        nsIDOMNode_GetPreviousSibling(node, &ret);
+    else
+        nsIDOMNode_GetNextSibling(node, &ret);
+    return ret;
+}
+
+/* takes the reference of next */
+static inline void node_replace(nsIDOMNode **node, nsIDOMNode *next)
+{
+    if(*node)
+        nsIDOMNode_Release(*node);
+    *node = next;
+}
+
+static HRESULT node_to_iface(nsIDOMNode *nsnode, IHTMLDOMNode **p)
+{
+    HTMLDOMNode *node;
+    HRESULT hres;
+
+    hres = get_node(nsnode, TRUE, &node);
+    if(SUCCEEDED(hres))
+        *p = &node->IHTMLDOMNode_iface;
+    return hres;
+}
+
+static HRESULT tree_walker_filter(struct tree_walker *This, nsIDOMNode *nsnode, LONG *result)
+{
+    static const WCHAR *accept_node = L"acceptNode";
+    DISPPARAMS dp = {NULL, NULL, 1, 0};
+    IHTMLDOMNode *node;
+    EXCEPINFO ei = {0};
+    DISPID dispid;
+    UINT16 type;
+    VARIANT arg, res;
+    HRESULT hres;
+
+    nsIDOMNode_GetNodeType(nsnode, &type);
+    if(type < 1 || type > 32 || !(This->what_to_show & (1u << (type - 1)))) {
+        *result = FILTER_SKIP;
+        return S_OK;
+    }
+    if(!This->filter) {
+        *result = FILTER_ACCEPT;
+        return S_OK;
+    }
+
+    hres = node_to_iface(nsnode, &node);
+    if(FAILED(hres))
+        return hres;
+
+    V_VT(&arg) = VT_DISPATCH;
+    V_DISPATCH(&arg) = (IDispatch*)node;
+    dp.rgvarg = &arg;
+    V_VT(&res) = VT_EMPTY;
+
+    /* the filter is either a function or an object with acceptNode */
+    if(SUCCEEDED(IDispatch_GetIDsOfNames(This->filter, &IID_NULL, (WCHAR**)&accept_node, 1, 0, &dispid)))
+        hres = IDispatch_Invoke(This->filter, dispid, &IID_NULL, GetUserDefaultLCID(), DISPATCH_METHOD,
+                                &dp, &res, &ei, NULL);
+    else
+        hres = call_disp_func(This->filter, &dp, &res);
+    IHTMLDOMNode_Release(node);
+    if(FAILED(hres))
+        return hres;
+
+    hres = VariantChangeType(&res, &res, 0, VT_I4);
+    *result = SUCCEEDED(hres) ? V_I4(&res) : FILTER_SKIP;
+    VariantClear(&res);
+    return S_OK;
+}
+
+/* takes the reference of node; NULL means the walk is over and currentNode stays */
+static HRESULT tree_walker_finish(struct tree_walker *This, nsIDOMNode *node, IHTMLDOMNode **p)
+{
+    *p = NULL;
+    if(!node)
+        return S_OK;
+    node_replace(&This->current, node);
+    return node_to_iface(node, p);
+}
+
+static HRESULT tree_walker_children(struct tree_walker *This, BOOL last, IHTMLDOMNode **p)
+{
+    nsIDOMNode *node, *next;
+    LONG result;
+    HRESULT hres;
+
+    node = node_child(This->current, last);
+    while(node) {
+        hres = tree_walker_filter(This, node, &result);
+        if(FAILED(hres)) {
+            nsIDOMNode_Release(node);
+            return hres;
+        }
+        if(result == FILTER_ACCEPT)
+            return tree_walker_finish(This, node, p);
+        if(result == FILTER_SKIP && (next = node_child(node, last))) {
+            node_replace(&node, next);
+            continue;
+        }
+        while(node) {
+            if((next = node_sibling(node, last))) {
+                node_replace(&node, next);
+                break;
+            }
+            next = node_parent(node);
+            if(!next || next == This->root || next == This->current) {
+                if(next)
+                    nsIDOMNode_Release(next);
+                nsIDOMNode_Release(node);
+                *p = NULL;
+                return S_OK;
+            }
+            node_replace(&node, next);
+        }
+    }
+    *p = NULL;
+    return S_OK;
+}
+
+static HRESULT tree_walker_siblings(struct tree_walker *This, BOOL prev, IHTMLDOMNode **p)
+{
+    nsIDOMNode *node, *sibling, *next;
+    LONG result;
+    HRESULT hres;
+
+    *p = NULL;
+    if(This->current == This->root)
+        return S_OK;
+
+    nsIDOMNode_AddRef(node = This->current);
+    for(;;) {
+        sibling = node_sibling(node, prev);
+        while(sibling) {
+            node_replace(&node, sibling);
+            hres = tree_walker_filter(This, node, &result);
+            if(FAILED(hres))
+                goto done;
+            if(result == FILTER_ACCEPT)
+                return tree_walker_finish(This, node, p);
+            sibling = result == FILTER_REJECT ? NULL : node_child(node, prev);
+            if(!sibling)
+                sibling = node_sibling(node, prev);
+        }
+        next = node_parent(node);
+        node_replace(&node, next);
+        if(!node || node == This->root)
+            break;
+        hres = tree_walker_filter(This, node, &result);
+        if(FAILED(hres))
+            goto done;
+        if(result == FILTER_ACCEPT)
+            break;
+    }
+    hres = S_OK;
+done:
+    if(node)
+        nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI tree_walker_get_root(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    return node_to_iface(impl_from_IWineDOMTreeWalker(iface)->root, p);
+}
+
+static HRESULT WINAPI tree_walker_get_whatToShow(IWineDOMTreeWalker *iface, ULONG *p)
+{
+    *p = impl_from_IWineDOMTreeWalker(iface)->what_to_show;
+    return S_OK;
+}
+
+static HRESULT WINAPI tree_walker_get_filter(IWineDOMTreeWalker *iface, IDispatch **p)
+{
+    struct tree_walker *This = impl_from_IWineDOMTreeWalker(iface);
+
+    if((*p = This->filter))
+        IDispatch_AddRef(*p);
+    return S_OK;
+}
+
+static HRESULT WINAPI tree_walker_get_expandEntityReferences(IWineDOMTreeWalker *iface, VARIANT_BOOL *p)
+{
+    *p = impl_from_IWineDOMTreeWalker(iface)->expand;
+    return S_OK;
+}
+
+static HRESULT WINAPI tree_walker_get_currentNode(IWineDOMTreeWalker *iface, IDispatch **p)
+{
+    return node_to_iface(impl_from_IWineDOMTreeWalker(iface)->current, (IHTMLDOMNode**)p);
+}
+
+static HRESULT WINAPI tree_walker_put_currentNode(IWineDOMTreeWalker *iface, IDispatch *v)
+{
+    struct tree_walker *This = impl_from_IWineDOMTreeWalker(iface);
+    IHTMLDOMNode *iface_node;
+    HTMLDOMNode *node;
+
+    if(!v || FAILED(IDispatch_QueryInterface(v, &IID_IHTMLDOMNode, (void**)&iface_node)))
+        return E_INVALIDARG;
+    if((node = unsafe_impl_from_IHTMLDOMNode(iface_node))) {
+        nsIDOMNode_AddRef(node->nsnode);
+        node_replace(&This->current, node->nsnode);
+    }
+    IHTMLDOMNode_Release(iface_node);
+    return node ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI tree_walker_parentNode(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    struct tree_walker *This = impl_from_IWineDOMTreeWalker(iface);
+    nsIDOMNode *node;
+    LONG result;
+    HRESULT hres;
+
+    *p = NULL;
+    nsIDOMNode_AddRef(node = This->current);
+    while(node && node != This->root) {
+        node_replace(&node, node_parent(node));
+        if(!node)
+            return S_OK;
+        hres = tree_walker_filter(This, node, &result);
+        if(FAILED(hres)) {
+            nsIDOMNode_Release(node);
+            return hres;
+        }
+        if(result == FILTER_ACCEPT)
+            return tree_walker_finish(This, node, p);
+    }
+    if(node)
+        nsIDOMNode_Release(node);
+    return S_OK;
+}
+
+static HRESULT WINAPI tree_walker_firstChild(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    return tree_walker_children(impl_from_IWineDOMTreeWalker(iface), FALSE, p);
+}
+
+static HRESULT WINAPI tree_walker_lastChild(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    return tree_walker_children(impl_from_IWineDOMTreeWalker(iface), TRUE, p);
+}
+
+static HRESULT WINAPI tree_walker_previousSibling(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    return tree_walker_siblings(impl_from_IWineDOMTreeWalker(iface), TRUE, p);
+}
+
+static HRESULT WINAPI tree_walker_nextSibling(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    return tree_walker_siblings(impl_from_IWineDOMTreeWalker(iface), FALSE, p);
+}
+
+static HRESULT WINAPI tree_walker_previousNode(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    struct tree_walker *This = impl_from_IWineDOMTreeWalker(iface);
+    nsIDOMNode *node, *sibling, *child;
+    LONG result;
+    HRESULT hres = S_OK;
+
+    *p = NULL;
+    nsIDOMNode_AddRef(node = This->current);
+    while(node != This->root) {
+        sibling = node_sibling(node, TRUE);
+        while(sibling) {
+            node_replace(&node, sibling);
+            hres = tree_walker_filter(This, node, &result);
+            if(FAILED(hres))
+                goto done;
+            while(result != FILTER_REJECT && (child = node_child(node, TRUE))) {
+                node_replace(&node, child);
+                hres = tree_walker_filter(This, node, &result);
+                if(FAILED(hres))
+                    goto done;
+            }
+            if(result == FILTER_ACCEPT)
+                return tree_walker_finish(This, node, p);
+            sibling = node_sibling(node, TRUE);
+        }
+        if(node == This->root || !(child = node_parent(node)))
+            break;
+        node_replace(&node, child);
+        hres = tree_walker_filter(This, node, &result);
+        if(FAILED(hres))
+            break;
+        if(result == FILTER_ACCEPT)
+            return tree_walker_finish(This, node, p);
+    }
+done:
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static HRESULT WINAPI tree_walker_nextNode(IWineDOMTreeWalker *iface, IHTMLDOMNode **p)
+{
+    struct tree_walker *This = impl_from_IWineDOMTreeWalker(iface);
+    nsIDOMNode *node, *next, *temp;
+    LONG result = FILTER_ACCEPT;
+    HRESULT hres = S_OK;
+
+    *p = NULL;
+    nsIDOMNode_AddRef(node = This->current);
+    for(;;) {
+        while(result != FILTER_REJECT && (next = node_child(node, FALSE))) {
+            node_replace(&node, next);
+            hres = tree_walker_filter(This, node, &result);
+            if(FAILED(hres))
+                goto done;
+            if(result == FILTER_ACCEPT)
+                return tree_walker_finish(This, node, p);
+        }
+
+        next = NULL;
+        nsIDOMNode_AddRef(temp = node);
+        while(temp && temp != This->root && !(next = node_sibling(temp, FALSE)))
+            node_replace(&temp, node_parent(temp));
+        if(temp)
+            nsIDOMNode_Release(temp);
+        if(!next)
+            goto done;
+
+        node_replace(&node, next);
+        hres = tree_walker_filter(This, node, &result);
+        if(FAILED(hres))
+            goto done;
+        if(result == FILTER_ACCEPT)
+            return tree_walker_finish(This, node, p);
+    }
+done:
+    nsIDOMNode_Release(node);
+    return hres;
+}
+
+static const IWineDOMTreeWalkerVtbl WineDOMTreeWalkerVtbl = {
+    tree_walker_QueryInterface,
+    tree_walker_AddRef,
+    tree_walker_Release,
+    tree_walker_GetTypeInfoCount,
+    tree_walker_GetTypeInfo,
+    tree_walker_GetIDsOfNames,
+    tree_walker_Invoke,
+    tree_walker_get_root,
+    tree_walker_get_whatToShow,
+    tree_walker_get_filter,
+    tree_walker_get_expandEntityReferences,
+    tree_walker_get_currentNode,
+    tree_walker_put_currentNode,
+    tree_walker_parentNode,
+    tree_walker_firstChild,
+    tree_walker_lastChild,
+    tree_walker_previousSibling,
+    tree_walker_nextSibling,
+    tree_walker_previousNode,
+    tree_walker_nextNode
+};
+
+static inline struct tree_walker *tree_walker_from_DispatchEx(DispatchEx *iface)
+{
+    return CONTAINING_RECORD(iface, struct tree_walker, dispex);
+}
+
+static void *tree_walker_query_interface(DispatchEx *dispex, REFIID riid)
+{
+    struct tree_walker *This = tree_walker_from_DispatchEx(dispex);
+
+    if(IsEqualGUID(&IID_IWineDOMTreeWalker, riid))
+        return &This->IWineDOMTreeWalker_iface;
+    return NULL;
+}
+
+static void tree_walker_traverse(DispatchEx *dispex, nsCycleCollectionTraversalCallback *cb)
+{
+    struct tree_walker *This = tree_walker_from_DispatchEx(dispex);
+
+    if(This->doc)
+        note_cc_edge((nsISupports*)&This->doc->node.IHTMLDOMNode_iface, "doc", cb);
+    if(This->root)
+        note_cc_edge((nsISupports*)This->root, "root", cb);
+    if(This->current)
+        note_cc_edge((nsISupports*)This->current, "current", cb);
+    if(This->filter)
+        note_cc_edge((nsISupports*)This->filter, "filter", cb);
+}
+
+static void tree_walker_unlink(DispatchEx *dispex)
+{
+    struct tree_walker *This = tree_walker_from_DispatchEx(dispex);
+
+    if(This->doc) {
+        HTMLDocumentNode *doc = This->doc;
+        This->doc = NULL;
+        IHTMLDOMNode_Release(&doc->node.IHTMLDOMNode_iface);
+    }
+    unlink_ref(&This->root);
+    unlink_ref(&This->current);
+    unlink_ref(&This->filter);
+}
+
+static void tree_walker_destructor(DispatchEx *dispex)
+{
+    free(tree_walker_from_DispatchEx(dispex));
+}
+
+static const dispex_static_data_vtbl_t tree_walker_dispex_vtbl = {
+    .query_interface  = tree_walker_query_interface,
+    .destructor       = tree_walker_destructor,
+    .traverse         = tree_walker_traverse,
+    .unlink           = tree_walker_unlink
+};
+
+static const tid_t TreeWalker_iface_tids[] = {
+    IWineDOMTreeWalker_tid,
+    0
+};
+
+dispex_static_data_t TreeWalker_dispex = {
+    .id              = OBJID_TreeWalker,
+    .vtbl            = &tree_walker_dispex_vtbl,
+    .disp_tid        = IWineDOMTreeWalker_tid,
+    .iface_tids      = TreeWalker_iface_tids,
+    .min_compat_mode = COMPAT_MODE_IE9,
+};
+
+HRESULT create_tree_walker(HTMLDocumentNode *doc, HTMLDOMNode *root, VARIANT *what_to_show, VARIANT *filter,
+                           VARIANT *expand, IWineDOMTreeWalker **p)
+{
+    struct tree_walker *ret;
+    VARIANT v;
+
+    if(!(ret = calloc(1, sizeof(*ret))))
+        return E_OUTOFMEMORY;
+
+    ret->what_to_show = SHOW_EVERYTHING;
+    V_VT(&v) = VT_EMPTY;
+    if(what_to_show && V_VT(what_to_show) != VT_EMPTY && V_VT(what_to_show) != VT_ERROR
+       && SUCCEEDED(VariantChangeType(&v, what_to_show, 0, VT_R8)))
+        ret->what_to_show = (ULONG)(LONGLONG)V_R8(&v);
+    if(filter && V_VT(filter) == VT_DISPATCH && V_DISPATCH(filter)) {
+        ret->filter = V_DISPATCH(filter);
+        IDispatch_AddRef(ret->filter);
+    }
+    if(expand && V_VT(expand) == VT_BOOL)
+        ret->expand = V_BOOL(expand);
+
+    ret->IWineDOMTreeWalker_iface.lpVtbl = &WineDOMTreeWalkerVtbl;
+    init_dispatch(&ret->dispex, &TreeWalker_dispex, doc->script_global,
+                  dispex_compat_mode(&doc->node.event_target.dispex));
+    IHTMLDOMNode_AddRef(&doc->node.IHTMLDOMNode_iface);
+    ret->doc = doc;
+    nsIDOMNode_AddRef(root->nsnode);
+    ret->root = root->nsnode;
+    nsIDOMNode_AddRef(root->nsnode);
+    ret->current = root->nsnode;
+
+    *p = &ret->IWineDOMTreeWalker_iface;
+    return S_OK;
+}
+
+struct node_filter {
+    DispatchEx dispex;
+    IWineDOMNodeFilter IWineDOMNodeFilter_iface;
+};
+
+static inline struct node_filter *impl_from_IWineDOMNodeFilter(IWineDOMNodeFilter *iface)
+{
+    return CONTAINING_RECORD(iface, struct node_filter, IWineDOMNodeFilter_iface);
+}
+
+DISPEX_IDISPATCH_IMPL(node_filter, IWineDOMNodeFilter, impl_from_IWineDOMNodeFilter(iface)->dispex)
+
+#define NODE_FILTER_CONST(name, value) \
+    static HRESULT WINAPI node_filter_get_##name(IWineDOMNodeFilter *iface, ULONG *p) \
+    { \
+        *p = value; \
+        return S_OK; \
+    }
+NODE_FILTER_CONST(FILTER_ACCEPT, FILTER_ACCEPT)
+NODE_FILTER_CONST(FILTER_REJECT, FILTER_REJECT)
+NODE_FILTER_CONST(FILTER_SKIP, FILTER_SKIP)
+NODE_FILTER_CONST(SHOW_ALL, 0xffffffff)
+NODE_FILTER_CONST(SHOW_ELEMENT, 0x1)
+NODE_FILTER_CONST(SHOW_ATTRIBUTE, 0x2)
+NODE_FILTER_CONST(SHOW_TEXT, 0x4)
+NODE_FILTER_CONST(SHOW_CDATA_SECTION, 0x8)
+NODE_FILTER_CONST(SHOW_ENTITY_REFERENCE, 0x10)
+NODE_FILTER_CONST(SHOW_ENTITY, 0x20)
+NODE_FILTER_CONST(SHOW_PROCESSING_INSTRUCTION, 0x40)
+NODE_FILTER_CONST(SHOW_COMMENT, 0x80)
+NODE_FILTER_CONST(SHOW_DOCUMENT, 0x100)
