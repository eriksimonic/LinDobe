+/* cl_khr_d3d11_sharing, device query only. Adobe's Mercury engine looks the Intel device up from its D3D11 device and
+ * leaves the OpenCL device uninitialized when the lookup is missing ("Hardware out of date"). The D3D11 device under
+ * Wine is DXVK's, on the same GPU when only one GPU is visible, so the platform's GPU devices are the answer. Object
+ * sharing (clCreateFromD3D11*) is not provided. */
+/* PCI vendor of the adapter behind a D3D11 device (CL_D3D11_DEVICE_KHR) or DXGI adapter (CL_D3D11_DXGI_ADAPTER_KHR) */
+static UINT d3d11_vendor( cl_uint source, void *object )
+{
+    IDXGIAdapter *adapter = NULL;
+    IDXGIDevice *device;
+    DXGI_ADAPTER_DESC desc;
+    UINT vendor = 0;
+
+    if (!object) return 0;
+    if (source == 0x4019 /* CL_D3D11_DEVICE_KHR */)
+    {
+        if (FAILED(IUnknown_QueryInterface( (IUnknown *)object, &IID_IDXGIDevice, (void **)&device ))) return 0;
+        IDXGIDevice_GetAdapter( device, &adapter );
+        IDXGIDevice_Release( device );
+    }
+    else if (source == 0x401A /* CL_D3D11_DXGI_ADAPTER_KHR */)
+    {
+        if (FAILED(IUnknown_QueryInterface( (IUnknown *)object, &IID_IDXGIAdapter, (void **)&adapter ))) return 0;
+    }
+    if (!adapter) return 0;
+    if (SUCCEEDED(IDXGIAdapter_GetDesc( adapter, &desc ))) vendor = desc.VendorId;
+    IDXGIAdapter_Release( adapter );
+    return vendor;
+}
+
+static cl_int WINAPI get_device_ids_from_d3d11( cl_platform_id platform, cl_uint source, void *object, cl_uint set,
+        cl_uint num_entries, cl_device_id *devices, cl_uint *num_devices )
+{
+    struct clGetDeviceIDs_params params = { platform, CL_DEVICE_TYPE_GPU, 0, NULL, NULL };
+    cl_device_id all[16];
+    cl_uint count = 0, found = 0, i, id;
+    UINT vendor = d3d11_vendor( source, object );
+    cl_int ret;
+
+    TRACE( "(%p, %#x, %p, %#x, %u, %p, %p) vendor %04x\n", platform, source, object, set, num_entries, devices,
+           num_devices, vendor );
+    params.num_entries = ARRAY_SIZE(all);
+    params.devices = all;
+    params.num_devices = &count;
+    if ((ret = OPENCL_CALL( clGetDeviceIDs, &params ))) return ret;
+    /* only the devices on the D3D11 device's GPU: a laptop's other GPU can't share its resources */
+    for (i = 0; i < min( count, ARRAY_SIZE(all) ); i++)
+    {
+        struct clGetDeviceInfo_params info = { all[i], CL_DEVICE_VENDOR_ID, sizeof(id), &id, NULL };
+        if (vendor && (OPENCL_CALL( clGetDeviceInfo, &info ) || id != vendor)) continue;
+        if (devices && found < num_entries) devices[found] = all[i];
+        found++;
+    }
+    if (num_devices) *num_devices = found;
+    TRACE( "-> %u device(s)\n", found );
+    return found ? CL_SUCCESS : -1000 /* CL_DEVICE_NOT_FOUND */;
+}
+
 void * WINAPI clGetExtensionFunctionAddressForPlatform( cl_platform_id platform, const char *func_name )
 {
+    if (func_name && !strcmp( func_name, "clGetDeviceIDsFromD3D11KHR" ))
+    {
+        TRACE( "(%p, %s)\n", platform, debugstr_a(func_name) );
+        return get_device_ids_from_d3d11;
+    }
     FIXME( "(%p, %s) stub!\n", platform, debugstr_a(func_name) );
     return NULL;
 }
