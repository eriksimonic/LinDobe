+/* drop the D3D11 device property (cl_khr_d3d11_sharing, see clGetExtensionFunctionAddressForPlatform): the host
+ * driver doesn't know it */
+static const cl_context_properties *strip_d3d11( const cl_context_properties *props, cl_context_properties *buf, int max )
+{
+    int i = 0;
+    if (!props) return NULL;
+    for (; props[0] && i < max - 3; props += 2)
+    {
+        if (props[0] == 0x401D /* CL_CONTEXT_D3D11_DEVICE_KHR */) { TRACE( "dropping CL_CONTEXT_D3D11_DEVICE_KHR\n" ); continue; }
+        buf[i++] = props[0]; buf[i++] = props[1];
+    }
+    buf[i] = 0;
+    return buf;
+}
+
 NTSTATUS wrap_clCreateContext( void *args )
 {
     struct clCreateContext_params *params = args;
+    cl_context_properties buf[64];
 
     if (params->pfn_notify) FIXME( "notify callback not supported\n" );
-    *params->__retval = clCreateContext( params->properties, params->num_devices, params->devices,
+    *params->__retval = clCreateContext( strip_d3d11( params->properties, buf, 64 ), params->num_devices, params->devices,
                                          NULL, NULL, params->errcode_ret );
     return STATUS_SUCCESS;
 }
@@ -48,9 +64,10 @@ NTSTATUS wrap_clCreateContext( void *args )
