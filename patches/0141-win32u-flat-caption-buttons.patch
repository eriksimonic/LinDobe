+/* Paint a flat outer edge of the given width in the active or inactive border colour, and shrink rect */
+static void draw_flat_edge( HDC hdc, RECT *rect, BOOL active, int width )
+{
+    HBRUSH prev_brush = NtGdiSelectBrush( hdc, get_sys_color_brush( active ? COLOR_ACTIVEBORDER :
+                                                                    COLOR_INACTIVEBORDER ));
+
+    NtGdiPatBlt( hdc, rect->left, rect->top, rect->right - rect->left, width, PATCOPY );
+    NtGdiPatBlt( hdc, rect->left, rect->bottom - width, rect->right - rect->left, width, PATCOPY );
+    NtGdiPatBlt( hdc, rect->left, rect->top, width, rect->bottom - rect->top, PATCOPY );
+    NtGdiPatBlt( hdc, rect->right - width, rect->top, width, rect->bottom - rect->top, PATCOPY );
+    NtGdiSelectBrush( hdc, prev_brush );
+    InflateRect( rect, -width, -width );
+}
